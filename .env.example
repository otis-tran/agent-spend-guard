# AgentSpend Guard - environment (copy to .env, never commit .env)
# Network: testnet only for this project
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# Accounts (fill in after creating them with a NEAR testnet wallet / near-cli)
# Owner account that sets the policies, e.g. yourname.testnet
OWNER_ACCOUNT_ID=
# Contract account, e.g. agentspend-guard.yourname.testnet (a sub-account of the owner)
CONTRACT_ACCOUNT_ID=
# Demo agent sub-account, e.g. agent1.yourname.testnet
AGENT_ACCOUNT_ID=

# Demo-agent credentials: path to the NEAR CLI credentials file for AGENT_ACCOUNT_ID
# Generated by `near login` / near-cli-rs into ~/.near-credentials/testnet/<account>.json
# Never paste a private key into chat or into this file in a committed repo.
AGENT_CREDENTIALS_PATH=

# Optional: NEAR AI Cloud (risk scoring in TEE) - $10 free credit via NEAR Builders
# Get the key at https://cloud.near.ai - store it only in your local .env
NEAR_AI_API_KEY=
